    {"id": "kanishka_council", "title": "A Buddhist council in Kashmir", "text": "The Kushan court patronises a great council of Buddhist monks, and missionaries travel north along the Silk Road.", "scenario": ["height_of_rome_117"], "tags": ["KUS"], "date": ["0120-01-01", "0160-12-31"], "mtth": 60, "once": true, "conditions": {}, "options": [{"text": "Patronise the council", "ai": 2, "historical": true, "effects": {"stability": 4, "support": {"clergy": 0.03}, "treasuryMonths": -0.3}}, {"text": "Stay aloof", "ai": 1, "effects": {"stability": -1}}]},
