{
  "events": [
    {"id": "hadrian_consolidation", "title": "Hadrian gives up the East", "text": "The new emperor Hadrian judges Trajan's conquests beyond the Euphrates impossible to hold and proposes to withdraw.", "scenario": ["height_of_rome_117"], "tags": ["ROM"], "date": ["0117-08-11", "0120-12-31"], "mtth": 2, "once": true, "news": true, "conditions": {"exists": "PAR", "notAtWarWith": "PAR"}, "options": [{"text": "Abandon Mesopotamia and secure the frontiers", "ai": 3, "historical": true, "effects": {"transfer": {"from": "ROM", "to": "PAR", "iso": ["IRQ"]}, "stability": 5, "legitimacy": 3}}, {"text": "Hold Trajan's conquests", "ai": 1, "effects": {"stability": -5, "manpower": -0.05, "treasuryMonths": -1}}]},
    {"id": "hadrians_wall", "title": "Hadrian's Wall", "text": "Hadrian orders a stone wall built across northern Britannia, from sea to sea.", "scenario": ["height_of_rome_117"], "tags": ["ROM"], "date": ["0122-01-01", "0130-12-31"], "mtth": 3, "once": true, "conditions": {}, "options": [{"text": "Build the wall", "ai": 3, "historical": true, "effects": {"treasuryMonths": -0.5, "modifier": {"name": "Hadrian's Wall", "months": 240, "effects": {"stability": 2}}}}, {"text": "Rely on the legions alone", "ai": 1, "effects": {"manpower": -0.03}}]},
