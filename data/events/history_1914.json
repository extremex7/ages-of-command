  "events": [
    {"id": "sarajevo", "title": "Assassination in Sarajevo", "text": "Archduke Franz Ferdinand, heir to the Habsburg throne, has been shot in Sarajevo by a Bosnian Serb nationalist. Vienna blames Belgrade.", "scenario": ["great_war_1914"], "tags": ["AUH"], "date": ["1914-06-15", "1914-09-30"], "mtth": 0.5, "once": true, "news": true, "conditions": {"exists": ["AUH", "SRB"], "notAtWarWith": "SRB"}, "options": [{"text": "Send an ultimatum to Serbia", "ai": 4, "historical": true, "effects": {"opinion": {"target": "SRB", "value": -40}, "stability": 2, "trigger": {"tag": "SRB", "event": "july_ultimatum"}}}, {"text": "Demand a joint inquiry only", "ai": 1, "effects": {"opinion": {"target": "SRB", "value": -15}, "legitimacy": -3}}]},
    {"id": "july_ultimatum", "title": "The July Ultimatum", "text": "Austria-Hungary demands that Serbia suppress anti-Austrian agitation and let Austrian officials take part in the investigation. Belgrade has 48 hours to reply.", "scenario": ["great_war_1914"], "tags": ["SRB"], "date": ["1914-06-15", "1914-12-31"], "mtth": 999, "once": true, "conditions": {"fired": "sarajevo", "exists": "AUH", "notAtWarWith": "AUH"}, "options": [{"text": "Accept most points, refuse the Austrian investigators", "ai": 4, "historical": true, "effects": {"stability": 3, "trigger": {"tag": "AUH", "event": "austria_declares_war"}}}, {"text": "Accept every demand", "ai": 1, "effects": {"stability": -10, "legitimacy": -12, "opinion": {"target": "AUH", "value": -20}}}]},
    {"id": "austria_declares_war", "title": "Austria-Hungary declares war on Serbia", "text": "Vienna judges the Serbian reply unsatisfactory. The army stands ready on the Danube.", "scenario": ["great_war_1914"], "tags": ["AUH"], "date": ["1914-06-15", "1914-12-31"], "mtth": 999, "once": true, "news": true, "conditions": {"fired": "july_ultimatum", "exists": "SRB", "notAtWarWith": "SRB"}, "options": [{"text": "Declare war on Serbia", "ai": 5, "historical": true, "effects": {"war": {"target": "SRB"}, "stability": 3}}, {"text": "Accept the reply and stand down", "ai": 1, "effects": {"legitimacy": -8, "modifier": {"name": "Climbdown over Serbia", "months": 24, "effects": {"faction": {"military": -12, "nationalists": -10}}}}}]},
    {"id": "russian_mobilisation", "title": "Russia mobilises", "text": "Austria-Hungary has attacked Serbia. St Petersburg must decide whether to stand by its Slavic ally.", "scenario": ["great_war_1914"], "tags": ["RUS"], "date": ["1914-07-01", "1915-06-30"], "mtth": 1, "once": true, "news": true, "conditions": {"warBetween": ["AUH", "SRB"], "notAtWarWith": "AUH", "exists": "RUS"}, "options": [{"text": "Order general mobilisation", "ai": 4, "historical": true, "effects": {"war": {"target": "AUH"}, "stability": 3, "trigger": {"tag": "GER", "event": "germany_honours_alliance"}}}, {"text": "Protest, but stay out", "ai": 1, "effects": {"legitimacy": -6, "opinion": {"target": "AUH", "value": -25}}}]},
    {"id": "germany_honours_alliance", "title": "The blank cheque", "text": "Russia has gone to war with Austria-Hungary. Berlin promised Vienna its full support; the General Staff wants to strike France before Russia is ready.", "scenario": ["great_war_1914"], "tags": ["GER"], "date": ["1914-07-01", "1915-12-31"], "mtth": 1, "once": true, "news": true, "conditions": {"warBetween": ["AUH", "RUS"], "notAtWarWith": "RUS", "exists": "AUH"}, "options": [{"text": "Stand by Austria and declare war on France", "ai": 5, "historical": true, "effects": {"joinWar": {"ally": "AUH"}, "war": {"target": "FRA"}, "stability": 4, "trigger": {"event": "schlieffen_plan"}}}, {"text": "Stand by Austria, fight Russia only", "ai": 1, "effects": {"joinWar": {"ally": "AUH"}, "stability": 2}}, {"text": "Leave Vienna on its own", "ai": 1, "effects": {"legitimacy": -10, "opinion": {"target": "AUH", "value": -40}}}]},
    {"id": "schlieffen_plan", "title": "The Schlieffen Plan", "text": "The war plan sends the German right wing through neutral Belgium to outflank the French fortresses.", "scenario": ["great_war_1914"], "tags": ["GER"], "date": ["1914-07-01", "1915-06-30"], "mtth": 1, "once": true, "news": true, "conditions": {"atWarWith": "FRA", "exists": "BEL", "notAtWarWith": "BEL"}, "options": [{"text": "March through Belgium", "ai": 4, "historical": true, "effects": {"war": {"target": "BEL"}, "trigger": {"tag": "GBR", "event": "british_entry"}}}, {"text": "Respect Belgian neutrality", "ai": 1, "effects": {"stability": -2, "modifier": {"name": "Frontal offensive", "months": 12, "effects": {"manpower": -0.05}}}}]},
    {"id": "british_entry", "title": "Britain and the scrap of paper", "text": "Germany is at war with France and Belgium, whose neutrality Britain guaranteed in 1839. The Cabinet must decide.", "scenario": ["great_war_1914"], "tags": ["GBR"], "date": ["1914-07-01", "1916-12-31"], "mtth": 2, "once": true, "news": true, "conditions": {"exists": "GER", "notAtWarWith": "GER", "any": [{"warBetween": ["GER", "BEL"]}, {"warBetween": ["GER", "FRA"]}]}, "options": [{"text": "Declare war on Germany", "ai": 4, "historical": true, "effects": {"war": {"target": "GER"}, "stability": 3}}, {"text": "Remain neutral", "ai": 1, "effects": {"legitimacy": -6, "opinion": {"target": "FRA", "value": -30}}}]},
    {"id": "ottoman_entry", "title": "The Ottoman Empire enters the war", "text": "German warships sheltering at Constantinople have shelled Russian ports. The war party in the Ottoman government urges joining the Central Powers.", "scenario": ["great_war_1914"], "tags": ["OTT"], "date": ["1914-10-01", "1915-12-31"], "mtth": 1.5, "once": true, "news": true, "conditions": {"exists": "GER", "warBetween": ["GER", "RUS"], "notAtWarWith": "RUS"}, "options": [{"text": "Join the Central Powers", "ai": 3, "historical": true, "effects": {"joinWar": {"ally": "GER"}, "opinion": {"target": "RUS", "value": -30}}}, {"text": "Disown the attack and stay neutral", "ai": 2, "effects": {"stability": 2, "legitimacy": -4}}]},
