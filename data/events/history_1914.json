    {"id": "us_entry", "title": "Unrestricted submarine warfare", "text": "Germany has resumed unrestricted submarine warfare, and an intercepted telegram shows Berlin offering Mexico an alliance against the United States.", "scenario": ["great_war_1914"], "tags": ["USA"], "date": ["1917-01-15", "1918-10-31"], "mtth": 2, "once": true, "news": true, "conditions": {"exists": ["GER", "GBR"], "warBetween": ["GER", "GBR"], "notAtWarWith": "GER", "year": [">=", 1917]}, "options": [{"text": "Ask Congress to declare war on Germany", "ai": 4, "historical": true, "effects": {"war": {"target": "GER"}, "stability": 3, "modifier": {"name": "Wartime mobilisation", "months": 24, "effects": {"manpower": 0.1}}}}, {"text": "Break off relations but stay out", "ai": 1, "effects": {"opinion": {"target": "GER", "value": -40}}}]},
    {"id": "february_revolution", "title": "The February Revolution", "text": "Bread riots and strikes in Petrograd have turned into revolution; the garrison has joined the crowds and the Duma demands the Tsar's abdication.", "scenario": ["great_war_1914"], "tags": ["RUS"], "date": ["1916-06-01", "1919-12-31"], "mtth": 3, "once": true, "news": true, "conditions": {"exists": "RUS", "atWar": true, "warMonths": [">", 18], "stability": ["<", 40], "notFired": "october_revolution"}, "options": [{"text": "The Tsar abdicates; a Provisional Government takes power", "ai": 4, "historical": true, "effects": {"government": "republic", "stability": -5, "legitimacy": -10, "support": {"liberals": 0.06, "socialists": 0.05}}}, {"text": "Crush the uprising", "ai": 1, "effects": {"stability": -8, "legitimacy": -15, "modifier": {"name": "Martial law in Petrograd", "months": 12, "effects": {"coupRisk": 1.5, "liberty": -0.1}}}}]},
