    {"id": "treaty_of_london", "title": "The Treaty of London", "text": "The Entente promises Italy the Trentino, South Tyrol and Istria if it enters the war against Austria-Hungary.", "scenario": ["great_war_1914"], "tags": ["ITA"], "date": ["1915-03-01", "1916-12-31"], "mtth": 2, "once": true, "news": true, "conditions": {"exists": "AUH", "notAtWarWith": "AUH", "any": [{"warBetween": ["AUH", "RUS"]}, {"warBetween": ["AUH", "SRB"]}, {"warBetween": ["AUH", "FRA"]}]}, "options": [{"text": "Sign and declare war on Austria-Hungary", "ai": 3, "historical": true, "effects": {"breakTreaties": "AUH", "war": {"target": "AUH"}, "claims": "AUH", "stability": -2}}, {"text": "Honour the Triple Alliance instead", "ai": 1, "effects": {"joinWar": {"ally": "AUH"}, "stability": -4}}, {"text": "Stay neutral", "ai": 1, "effects": {"stability": 2}}]},
