  "events": [
    {"id": "rhineland", "title": "Remilitarisation of the Rhineland", "text": "The Versailles treaty left the Rhineland demilitarised. Hitler proposes to send troops back across the Rhine, gambling that France will not respond.", "scenario": ["gathering_storm_1936"], "tags": ["GER"], "date": ["1936-02-15", "1937-12-31"], "mtth": 1, "once": true, "news": true, "conditions": {"exists": "FRA", "notAtWarWith": "FRA"}, "options": [{"text": "March into the Rhineland", "ai": 4, "historical": true, "effects": {"stability": 4, "legitimacy": 6, "support": {"nationalists": 0.03}, "trigger": {"tag": "FRA", "event": "rhineland_france"}}}, {"text": "Hold back", "ai": 1, "effects": {"legitimacy": -4, "modifier": {"name": "Rhineland climbdown", "months": 24, "effects": {"faction": {"nationalists": -10, "military": 5}}}}}]},
    {"id": "rhineland_france", "title": "German troops on the Rhine", "text": "German battalions have entered the demilitarised Rhineland. Paris must decide whether to answer with force months before an election.", "scenario": ["gathering_storm_1936"], "tags": ["FRA"], "date": ["1936-02-15", "1937-12-31"], "mtth": 999, "once": true, "conditions": {"fired": "rhineland", "exists": "GER", "notAtWarWith": "GER"}, "options": [{"text": "Protest to the League of Nations", "ai": 4, "historical": true, "effects": {"stability": -2, "opinion": {"target": "GER", "value": -25}}}, {"text": "Mobilise and march", "ai": 1, "effects": {"war": {"target": "GER"}, "stability": -5}}]},
    {"id": "spanish_civil_war", "title": "Spain divided", "text": "Army garrisons have risen against the Popular Front government. Spain is split in two and the fighting is ferocious on both sides.", "scenario": ["gathering_storm_1936"], "tags": ["SPA"], "date": ["1936-07-01", "1937-12-31"], "mtth": 1, "once": true, "news": true, "conditions": {"exists": "SPA", "atWar": false}, "options": [{"text": "The Nationalists win", "ai": 3, "historical": true, "effects": {"government": "military", "support": {"nationalists": 0.1, "clergy": 0.05, "socialists": -0.1}, "stability": -15, "popShare": -0.01, "dev": -0.5}}, {"text": "The Republic survives", "ai": 2, "effects": {"government": "parliamentary", "support": {"socialists": 0.1, "liberals": 0.03, "nationalists": -0.08}, "stability": -15, "popShare": -0.01, "dev": -0.5}}]},
    {"id": "ethiopia_conquered", "title": "The fall of Addis Ababa", "text": "Italian columns have taken Addis Ababa and Emperor Haile Selassie has gone into exile.", "scenario": ["gathering_storm_1936"], "tags": ["ITA"], "date": ["1936-01-01", "1938-12-31"], "mtth": 1, "once": true, "news": true, "conditions": {"exists": "ETH", "atWarWith": "ETH", "warScore": [">", 20]}, "options": [{"text": "Proclaim the Italian Empire", "ai": 4, "historical": true, "effects": {"annex": "ETH", "legitimacy": 5, "stability": 3}}, {"text": "Negotiate a peace that keeps the border regions", "ai": 1, "effects": {"peace": {"with": "ETH"}, "transfer": {"from": "ETH", "border": true}}}]},
