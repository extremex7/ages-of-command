    {"id": "anschluss_pressure", "title": "Berlin's ultimatum to Vienna", "text": "Hitler demands that Chancellor Schuschnigg cancel his plebiscite on independence and hand power to the Austrian Nazis. Troops gather at the border.", "scenario": ["gathering_storm_1936"], "tags": ["AUT"], "date": ["1938-02-01", "1939-06-30"], "mtth": 1.5, "once": true, "news": true, "conditions": {"exists": "GER", "notAtWarWith": "GER", "not": {"any": [{"allied": "ITA"}, {"allied": "FRA"}, {"allied": "GBR"}, {"allied": "SOV"}]}}, "options": [{"text": "Yield to the ultimatum", "ai": 3, "historical": true, "effects": {"trigger": {"tag": "GER", "event": "anschluss"}}}, {"text": "Hold the plebiscite and resist", "ai": 1, "effects": {"stability": 3, "legitimacy": 5, "opinion": {"target": "GER", "value": -50}}}]},
