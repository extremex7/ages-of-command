    {"id": "guarantee_of_poland", "title": "Guarantee of Poland", "text": "After the fall of Prague, London and Paris weigh a public guarantee of Polish independence.", "scenario": ["gathering_storm_1936"], "tags": ["GBR", "FRA"], "date": ["1939-03-01", "1939-12-31"], "mtth": 1, "cooldownYears": 50, "conditions": {"exists": ["POL", "GER"], "notAtWarWith": "GER", "any": [{"fired": "occupation_of_bohemia"}, {"fired": "munich_agreement"}]}, "options": [{"text": "Guarantee Poland", "ai": 4, "historical": true, "effects": {"treaty": {"type": "guarantee", "with": "POL"}, "opinion": {"target": "GER", "value": -20}}}, {"text": "Avoid new commitments", "ai": 1, "effects": {"legitimacy": -3}}]},
