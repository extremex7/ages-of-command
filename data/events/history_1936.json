    {"id": "sudeten_crisis", "title": "The Sudeten crisis", "text": "Hitler demands the German-speaking border districts of Czechoslovakia and threatens war. Britain and France seek a settlement.", "scenario": ["gathering_storm_1936"], "tags": ["GER"], "date": ["1938-05-01", "1939-06-30"], "mtth": 1.5, "once": true, "news": true, "conditions": {"exists": "CZS", "notAtWarWith": "CZS", "fired": "anschluss"}, "options": [{"text": "Demand the Sudetenland", "ai": 4, "historical": true, "effects": {"trigger": {"tag": "CZS", "event": "munich_czs"}}}, {"text": "Drop the demand", "ai": 1, "effects": {"legitimacy": -5}}]},
