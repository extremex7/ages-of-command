  "religion": {
    "_doc": "mismatchUnrest: unrest in a province whose religion differs from the state religion, times the family factor (sameFamily, or secular when either is secular) and the religion policy's unrest multiplier. stabilityWeight × share of people of another religion × the policy's stability multiplier is taken from the stability target; the state religion policy adds up to unityBonus when nearly everyone shares it. A province converts to the state religion in about conversionYears, faster with the policy's conversion multiplier, civil spending (civilShare ÷ civilRef), a related religion (sameFamilyConversion) and calm, slower when unrest is high. Changing the state religion costs changeStability, changeLegitimacy and clergy approval for changeMonths, needs changeMinShare of the people to follow it and waits changeCooldownYears. Opinion between countries: sameOpinion for a shared state religion, familyOpinion for the same family, zealOpinion between different families when either has the state religion policy or a theocracy.",
    "mismatchUnrest": 18, "sameFamily": 0.6, "secular": 0.5,
    "policy": {
      "state": { "unrest": 1.5, "stability": 1.2, "conversion": 2.5 },
      "tolerant": { "unrest": 0.55, "stability": 0.5, "conversion": 1 },
      "secular": { "unrest": 0.75, "stability": 0.6, "conversion": 0.6 }
    },
    "stabilityWeight": 10, "unityBonus": 2,
    "conversionYears": 70, "civilRef": 0.75, "sameFamilyConversion": 1.6, "conversionUnrestStop": 60,
    "changeStability": 10, "changeLegitimacy": 15, "changeClergy": -20, "changeMonths": 60, "changeMinShare": 0.1, "changeCooldownYears": 25,
    "sameOpinion": 8, "familyOpinion": 3, "zealOpinion": -6
  },
  "unrest": {
    "_doc": "Each month a province's unrest (0-100) moves `smoothing` of the way toward a target: stability × (50 - stability), religion (above), conquest × (1 - years held ÷ integrationYears, at least conquestFloor) in provinces that are not the owner's core, separatism where a country that could be released or the former owner claims it, warExhaustion × the owner's war exhaustion, tax × (tax rate - taxFree), food × the food shortage, minus civil × (civil share - civilRef), garrisonPerUnit per land unit of the owner in it (at most garrisonMax), the suppression left from a crackdown, capital, and ages. Unrest above stabilityFree (people-weighted) costs stabilityWeight stability a point; a province pays (1 - taxLoss × unrest) of its taxes. War exhaustion grows warGrowth a month at war, plus warOccupied × the share occupied and warLosing when the war score is below -20, and falls by warDecay of itself a month in peace; it costs warStability stability a point.",
    "smoothing": 0.15, "stability": 0.4, "conquest": 22, "conquestFloor": 0.25, "separatism": 6, "integrationYears": 50,
    "warExhaustion": 0.25, "tax": 60, "taxFree": 0.2, "food": 25, "civil": 30, "civilRef": 0.7,
    "garrisonPerUnit": 4, "garrisonMax": 20, "capital": 10,
    "stabilityFree": 15, "stabilityWeight": 0.15, "taxLoss": 0.004,
    "warGrowth": 1, "warOccupied": 4, "warLosing": 1, "warDecay": 0.06, "warStability": 0.05
  },
  "revolts": {
    "_doc": "A province above `unrest` that its owner controls may revolt with chance × (unrest - threshold) ÷ (100 - threshold) a month (one new revolt per country a month, at most maxPerCountry at once). Rebels muster minUnits + province people ÷ popPerUnit × unrest/100 units of the owner's best line infantry (at most maxUnits) and fight at rebelPower of an army, rebelTerrain in hills, mountains and forest. They take an undefended province in siegeDays + siegeFortDays × fort days, then move on. An army of the owner in the same province fights them every day: rebels lose rebelDamage × share of power, the army armyDamage strength and armyOrgDamage organisation; below crushedStr the revolt is crushed. Revolts grow `growth` units a month for each province they hold. Holding land for demandMonths wins a faith or popular revolt its demands; separatists who hold land for independenceMonths declare independence. A crackdown (suppress) costs suppressCost of a month's tax revenue (at least suppressMin), lowers unrest by suppressUnrest and keeps it down by suppressDuration points fading suppressDecay a month, for suppressLegitimacy legitimacy.",
    "unrest": 40, "chance": 0.08, "maxPerCountry": 3, "popPerUnit": 1000000, "minUnits": 1, "maxUnits": 20, "growth": 0.3,
    "rebelPower": 0.75, "rebelTerrain": 1.25, "rebelDamage": 0.05, "armyDamage": 0.012, "armyOrgDamage": 0.03, "crushedStr": 0.15,
    "siegeDays": 25, "siegeFortDays": 15, "demandMonths": 12, "independenceMonths": 18,
    "stabilityPerRevolt": 2, "heldStability": 15, "crushedUnrest": 10,
    "suppressCost": 0.05, "suppressMin": 0.001, "suppressUnrest": 15, "suppressDuration": 25, "suppressDecay": 2.5, "suppressLegitimacy": 1,
    "aiSuppressUnrest": 42, "aiArmyMargin": 1.6
  },
  "ages": {
    "_doc": "A month counts toward a golden age when stability is at least golden.stability, average unrest below golden.maxUnrest, food and living standard at least golden.prosperity, prestige rising (the score at least golden.prestigeGrowth above its slow three-year average) and the country is not losing a war; other months take away 2. With golden.momentum months banked the age begins with golden.chance a month, unless golden.maxShare of the living countries already have one. It lasts golden.years (research ×research, growth ×growth, stability +stability, unrest -unrest) and ends early below golden.endStability; the next one waits golden.cooldownYears. Crisis months (stability under dark.stability, hunger, inflation above dark.inflation, war exhaustion above dark.warExhaustion, or a revolt holding land) bank toward a dark age the same way; it lasts up to dark.years and ends once stability stays at or above dark.recoverStability for dark.recoverMonths months.",
    "golden": { "stability": 65, "maxUnrest": 15, "prosperity": 0.95, "prestigeGrowth": 0.2, "momentum": 24, "chance": 0.025, "maxShare": 0.06, "years": 15, "cooldownYears": 60, "research": 1.15, "growth": 1.25, "stabilityBonus": 5, "unrest": 8, "endStability": 30 },
    "dark": { "stability": 30, "inflation": 0.15, "warExhaustion": 50, "food": 0.85, "momentum": 18, "chance": 0.05, "years": 10, "cooldownYears": 30, "recoverStability": 55, "recoverMonths": 12, "research": 0.85, "growth": 0.75, "stabilityPenalty": 5, "unrest": 8 }
  }
